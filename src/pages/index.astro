---
import { buildCalendar, addDays, formatDateLabel, SLOT_MINUTES } from "../lib/calendar";
import { listBookings, listRooms, nowLocal, MAX_DURATION_MINUTES } from "../lib/db";
import "../styles.css";

const rooms = listRooms();
const bookings = listBookings();
const now = nowLocal();

const ERROR_TEXT: Record<string, string> = {
  missing: "Every field is required.",
  "unknown-room": "That room doesn't exist.",
  "bad-format": "That doesn't look like a valid date and time.",
  "too-long": "Pod and tutor names can't be longer than 80 characters.",
  "bad-range": "The booking has to end after it starts.",
  "duration-too-long": `Bookings can be at most ${MAX_DURATION_MINUTES / 60} hours long.`,
  conflict: "That room is already booked for part of that time.",
};
const errorCode = Astro.url.searchParams.get("error");
const errorRoomId = Astro.url.searchParams.get("roomId");
const errorRoomName = errorRoomId
  ? rooms.find((room) => room.id === Number(errorRoomId))?.name
  : undefined;

// On a rejected submission, refill the form from what was actually sent —
// see api/bookings.ts's withInput — rather than making someone retype every
// field over a single bad one (WCAG 2.2 SC 3.3.7, Redundant Entry). Clicking
// an open slot on the calendar below reuses these same three params to
// prefill a fresh booking instead, with no error involved.
const resubmitPod = Astro.url.searchParams.get("pod") ?? "";
const resubmitTutor = Astro.url.searchParams.get("tutor") ?? "";
const resubmitStartsAt = Astro.url.searchParams.get("startsAt") ?? "";
const resubmitEndsAt = Astro.url.searchParams.get("endsAt") ?? "";
const cameFromCalendar = !errorCode && resubmitStartsAt !== "";

const today = now.slice(0, 10);
const selectedDate = Astro.url.searchParams.get("date") ?? today;
const prevDate = addDays(selectedDate, -1);
const nextDate = addDays(selectedDate, 1);
const { times, grid } = buildCalendar(selectedDate, rooms, bookings, now);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crit Rooms</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Crit Rooms</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Crit Rooms</h1>
      <p>
        Book one of the course's crit rooms for a pod's session. Two pods can't
        book the same room for overlapping times — the form below checks
        before it accepts anything, so nobody finds out in person.
      </p>

      {
        errorCode && (
          <p role="alert" class="error">
            {ERROR_TEXT[errorCode] ?? "That booking couldn't be made."}
            {errorCode === "conflict" && errorRoomName && ` (${errorRoomName})`}
          </p>
        )
      }

      <form id="book" method="post" action="/api/bookings">
        <div class="field">
          <label for="roomId">Room</label>
          <select id="roomId" name="roomId" required>
            {
              rooms.map((room) => (
                <option value={room.id} selected={errorRoomId === String(room.id)}>
                  {room.name}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="pod">Pod</label>
          <input
            id="pod"
            name="pod"
            required
            maxlength="80"
            placeholder="e.g. Dachi"
            value={resubmitPod}
            autofocus={cameFromCalendar}
          />
        </div>
        <div class="field">
          <label for="tutor">Tutor</label>
          <input
            id="tutor"
            name="tutor"
            maxlength="80"
            placeholder="optional"
            value={resubmitTutor}
          />
        </div>
        <div class="field">
          <label for="startsAt">Starts</label>
          <input
            id="startsAt"
            name="startsAt"
            type="datetime-local"
            step={SLOT_MINUTES * 60}
            required
            value={resubmitStartsAt}
          />
        </div>
        <div class="field">
          <label for="endsAt">Ends</label>
          <input
            id="endsAt"
            name="endsAt"
            type="datetime-local"
            step={SLOT_MINUTES * 60}
            required
            value={resubmitEndsAt}
          />
        </div>
        <button>Book the room</button>
      </form>
      <p class="hint">Bookings can be up to {MAX_DURATION_MINUTES / 60} hours long.</p>

      <h2>Schedule</h2>
      <nav class="cal-nav" aria-label="Calendar date">
        <a href={`/?date=${prevDate}`}>&larr; {formatDateLabel(prevDate)}</a>
        <strong>{formatDateLabel(selectedDate)}</strong>
        <a href={`/?date=${nextDate}`}>{formatDateLabel(nextDate)} &rarr;</a>
        {selectedDate !== today && <a href="/">Today</a>}
      </nav>
      <p>Click an open slot to start a booking for that room and time.</p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Schedule calendar">
        <table class="calendar">
          <thead>
            <tr>
              <th scope="col">Time</th>
              {rooms.map((room) => <th scope="col">{room.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              times.map((time, rowIndex) => (
                <tr>
                  <th scope="row">{time}</th>
                  {
                    rooms.map((room, roomIndex) => {
                      const cell = grid[rowIndex][roomIndex];
                      if (cell.kind === "covered") return null;

                      if (cell.kind === "booking") {
                        const { booking, rowSpan, isPast } = cell;
                        return (
                          <td rowspan={rowSpan} class={`cal-booking ${isPast ? "past" : ""}`}>
                            <strong>{booking.pod}</strong>
                            {booking.tutor && <> — {booking.tutor}</>}
                            <br />
                            <span class="cal-time">
                              {booking.startsAt.slice(11)}–{booking.endsAt.slice(11)}
                              {isPast && " (past)"}
                            </span>
                          </td>
                        );
                      }

                      if (!cell.bookable) {
                        return <td class="cal-unbookable"></td>;
                      }

                      return (
                        <td class="cal-empty">
                          <a
                            class="cal-book-link"
                            href={`/?date=${selectedDate}&roomId=${room.id}&startsAt=${cell.startsAt}&endsAt=${cell.endsAt}#book`}
                            aria-label={`Book ${room.name} at ${time} on ${formatDateLabel(selectedDate)}`}
                          >
                            +
                          </a>
                        </td>
                      );
                    })
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 id="live-heading">Just booked</h2>
      <p>New bookings from other tabs appear here as they happen.</p>
      <ul id="live" aria-labelledby="live-heading" aria-live="polite"></ul>
    </main>
    <script>
      // The live half of the app: subscribe to the SSE stream and note new
      // bookings from other tabs as they happen. The form itself needs none
      // of this — its POST + redirect re-renders the submitting tab's own
      // schedule from SQLite; this stream is how every other tab finds out,
      // without re-sorting the schedule table client-side.
      const live = document.querySelector("#live");
      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const booking = JSON.parse(event.data);
        const item = document.createElement("li");
        item.textContent = `${booking.roomName}: ${booking.pod}, ${booking.startsAt.replace("T", " ")}–${booking.endsAt.replace("T", " ")}`;
        live?.prepend(item);
      });
    </script>
  </body>
</html>
